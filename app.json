{
  "expo": {
    "name": "mytfare",
    "slug": "mytfare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mytfare"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Sora",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Sora-400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Sora-600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Sora-700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Sora-800ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Manrope-400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Manrope-500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Manrope-600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Manrope-700Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Sora-400Regular.ttf",
              "./assets/fonts/Sora-600SemiBold.ttf",
              "./assets/fonts/Sora-700Bold.ttf",
              "./assets/fonts/Sora-800ExtraBold.ttf",
              "./assets/fonts/Manrope-400Regular.ttf",
              "./assets/fonts/Manrope-500Medium.ttf",
              "./assets/fonts/Manrope-600SemiBold.ttf",
              "./assets/fonts/Manrope-700Bold.ttf"
            ]
          }
        }
      ]
    ]
  }
}
